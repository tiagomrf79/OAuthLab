@{
    ViewData["Title"] = "Confidential Client";
}

<header class="text-center mb-4">
    <h1 class="display-6">OAuth2 Confidential Client</h1>
    <p class="text-muted">A playground for exercising OAuth 2.0 grant types against the local Authorization Server</p>
</header>

<div class="oauth-client-layout">
    <section class="oauth-panel">
        <h2>Flows</h2>
        <div class="oauth-actions-grid">
            <a asp-action="AuthorizationCode" class="oauth-action-btn">
                <span class="oauth-action-title">Authorization Code</span>
                <span class="oauth-action-desc">User signs in at the AS; the client exchanges a code for tokens</span>
            </a>
            <a asp-action="AuthorizationCodePkce" class="oauth-action-btn">
                <span class="oauth-action-title">Authorization Code + PKCE</span>
                <span class="oauth-action-desc">Same flow, with a code verifier binding the code to this client's request on top of its secret</span>
            </a>
            <a asp-action="ClientCredentials" class="oauth-action-btn">
                <span class="oauth-action-title">Client Credentials</span>
                <span class="oauth-action-desc">The client authenticates directly with its own credentials — no user involved</span>
            </a>
            <a asp-action="Password" class="oauth-action-btn">
                <span class="oauth-action-title">Resource Owner Password Credentials</span>
                <span class="oauth-action-desc">The user hands their username and password straight to the client</span>
            </a>
        </div>
    </section>
</div>
